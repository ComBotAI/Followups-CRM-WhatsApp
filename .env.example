# Followups CRM. Fill in the backend values below before building. Everything brand- or account-specific lives here, so the same
# source can ship under any brand: see docs/REBRANDING.md.
#
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who has it.
# They are public identifiers, never secrets: do not put API secrets or passwords here.

# ─── Brand ────────────────────────────────────────────────────────────────────
# Full app name: launcher label, store name, page titles, permission prompts.
EXPO_PUBLIC_APP_NAME=Followups CRM
# Company / short brand name: "Contact <brand> support", copyright, share texts.
EXPO_PUBLIC_BRAND_NAME=Followups CRM
# Expo slug: lowercase, dashes only. Must match the EAS project's slug.
EXPO_PUBLIC_APP_SLUG=followups-crm
# Deep-link scheme (no "://"): lowercase letters and digits only, e.g. followupscrm://lead/123
EXPO_PUBLIC_APP_SCHEME=followupscrm
# Play Store application id (reverse domain). Can't be changed after the first store upload.
EXPO_PUBLIC_ANDROID_PACKAGE=crm.followups.wa
# App Store bundle id. Leave empty to use the Android package.
EXPO_PUBLIC_IOS_BUNDLE_ID=
# Main brand colour (Android adaptive-icon background, notification accent).
EXPO_PUBLIC_BRAND_COLOR=#2F5BEA
# Domain the web app is hosted on (no https://). Used for email links (verify, reset password)
# that open the app, SEO tags and the sitemap. Leave empty if you have no web app.
EXPO_PUBLIC_WEB_DOMAIN=followups.example.com
# Page where users ask to delete their account and data (Google Play and App Store require one).
# Shown as "Delete account" in More. Leave empty to hide the row.
EXPO_PUBLIC_DELETE_ACCOUNT_URL=https://example.com/delete-account/

# ─── EAS (Expo build service) ────────────────────────────────────────────────
# From `npx eas-cli@latest init` or expo.dev > your project. Leave empty before running `eas init`.
EAS_PROJECT_ID=
# Your Expo account or organisation name.
EAS_OWNER=

# ─── Backend ──────────────────────────────────────────────────────────────────
# SSO (Auth-as-a-Service) origin, e.g. https://partner-api.example.com
EXPO_PUBLIC_SSO_URL=https://sso.1automations.com
EXPO_PUBLIC_CPASS_BASE_URL=https://cpaasgateway.1automations.com
# Recommended: your SDK project id. When set, the Access ID screen is never shown and every
# sign-in uses this id. Leave empty only if users should enter or scan their own Access ID.
EXPO_PUBLIC_ACCESS_ID=

# ─── Data store ───────────────────────────────────────────────────────────────
# Nothing is created automatically. After signing in, the workspace owner goes through
# Workspace setup: (1) create the lead fields, (2) pick a data store plan from the CPaaS
# catalogue, then the store and its tables are created on it. No billing in the app.
#
# Name of the CRM data store the app keeps its data in. Leave empty to use the app name.
# Don't change it on a live app: workspaces would start a new, empty store.
EXPO_PUBLIC_DATASTORE_TITLE=followupscrm

# ─── Push notifications (Firebase) ───────────────────────────────────────────
# Android / iOS push uses the native Firebase files, not these variables: replace
# google-services.json and GoogleService-Info.plist in the project root with your own
# (or point to them here).
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Web push: Firebase Console > Project settings > General > Your apps > Web app > SDK config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Web push key pair (Firebase Console > Project settings > Cloud Messaging > Web Push certificates)
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# ─── Web hosting files (used by `npm run brand:web`, not bundled) ────────────
# Apple Developer Team ID, for iOS Universal Links (public/.well-known/apple-app-site-association).
APPLE_TEAM_ID=
# SHA-256 fingerprint(s) of your Android signing key, comma-separated, for Android App Links
# (public/.well-known/assetlinks.json). Get it with `npx eas-cli@latest credentials`.
ANDROID_SHA256_CERT_FINGERPRINTS=
